# ─────────────────────────────────────────────────────────────
#  Kamui Collection — переменные окружения
#  Скопируйте файл в .env.local (локально) или задайте в панели хостинга.
#  Всё, кроме Google Таблицы, можно пока не трогать.
# ─────────────────────────────────────────────────────────────

# Адрес сайта (для SEO, ссылок и возврата после оплаты)
NEXT_PUBLIC_SITE_URL=https://kamui-collection.ru

# ── Остаток (если не подключена Google Таблица с листом «Настройки») ──
# Осталось = TOTAL_STOCK − SOLD_COUNT
TOTAL_STOCK=2000
SOLD_COUNT=49

# ── Google Таблица «Kamui Collection — Заказы» ──
# URL веб-приложения Apps Script (заканчивается на /exec) и секрет из скрипта
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=
# Брать остаток из листа «Настройки» (true по умолчанию)
STOCK_FROM_SHEET=true

# ── Локальная копия заявок (data/orders.jsonl) ──
# Держите включённой на своём сервере. На Vercel выключите (false) — там нельзя писать файлы.
ORDERS_FILE_STORE=true
# ORDERS_FILE_PATH=/app/data/orders.jsonl

# ── ЮKassa: онлайн-оплата ──
# Включите, когда будут ключи из личного кабинета ЮKassa (Интеграция → Ключи API).
# Для проверки можно сначала вписать ключи тестового магазина.
PAYMENTS_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Отправлять чек 54-ФЗ («Чеки от ЮKassa» или своя онлайн-касса, подключённая к ЮKassa)
YOOKASSA_SEND_RECEIPT=false
# Ставка НДС в чеке: 1 — без НДС
YOOKASSA_VAT_CODE=1
# Система налогообложения для чека (1 — ОСН, 2 — УСН доходы, 3 — УСН доходы-расходы, 6 — патент). Можно не задавать.
# YOOKASSA_TAX_SYSTEM_CODE=2
# Куда вернуть покупателя после оплаты. По умолчанию https://kamui-collection.ru/?order=<номер>#buy
# YOOKASSA_RETURN_URL=
# Адрес для уведомлений (указать в ЮKassa → Интеграция → HTTP-уведомления, события payment.succeeded и payment.canceled):
#   https://kamui-collection.ru/api/payments/yookassa/webhook

# ── СДЭК: доставка до пункта выдачи ──
# Ключи — в личном кабинете lk.cdek.ru → Интеграция (нужен договор с СДЭК).
CDEK_ENABLED=false
# true — учебная среда api.edu.cdek.ru (тестовые ключи), false — боевая
CDEK_TEST_MODE=false
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Код города отправки в справочнике СДЭК (узнать: /api/delivery/cdek/cities?q=Краснодар, когда СДЭК включён)
CDEK_FROM_CITY_CODE=
# Код ПВЗ, куда вы сдаёте посылки (виден на сайте СДЭК в карточке пункта, например KRD12)
CDEK_SHIPMENT_POINT=
# Тариф: 136 — «Посылка склад-склад»
CDEK_TARIFF_CODE=136
# Упаковка одной штуки: вес в граммах и размеры в сантиметрах (несколько штук — стопкой по высоте)
CDEK_ITEM_WEIGHT_G=23
CDEK_ITEM_LENGTH_CM=26
CDEK_ITEM_WIDTH_CM=18
CDEK_ITEM_HEIGHT_CM=1
# Дополнительный вес коробки/пакета на всю посылку, г
CDEK_BOX_WEIGHT_G=0
# Подарочный набор (мел, фото с автографом, салфетка, наклейка JOS): размеры коробки, см, и вес собранного набора, г.
# Каждый набор — отдельное место (коробка) в посылке
CDEK_KIT_LENGTH_CM=30
CDEK_KIT_WIDTH_CM=22
CDEK_KIT_HEIGHT_CM=8
CDEK_KIT_WEIGHT_G=400
# Страховка объявленной стоимости (стоимость мела в заказе) входит в цену доставки: СДЭК считает её вместе с тарифом.
# false — не учитывать. Процент нужен только на случай, если СДЭК не посчитал страховку сам (обычно 0,75 %)
CDEK_INSURANCE=true
CDEK_INSURANCE_PERCENT=0.75
# Кто платит за доставку: customer — покупатель (стоимость добавляется к заказу), free — бесплатно для покупателя
DELIVERY_PRICE_MODE=customer
# Наценка к тарифу СДЭК для покупателя, %
DELIVERY_MARKUP_PERCENT=30
# Создавать отправление в СДЭК автоматически после оплаты (false — оформлять вручную в lk.cdek.ru)
CDEK_AUTO_SHIPMENT=true
# Страны доставки СДЭК с оплатой на сайте. Пусто — только Россия.
# Включить страны ЕАЭС (Беларусь, Казахстан, Армения, Кыргызстан): CDEK_COUNTRIES=RU,BY,KZ,AM,KG
# Остальные страны — заявка менеджеру («Другая страна»).
CDEK_COUNTRIES=RU

# ── Robokassa: оплата заказов с доставкой СДЭК за пределы России (Беларусь, Казахстан, Армения, Кыргызстан) ──
# Личный кабинет Robokassa → Мои магазины → магазин → Технические настройки.
# Там же укажите:  Result URL  https://kamui-collection.ru/api/payments/robokassa/result   (метод POST)
#                  Success URL https://kamui-collection.ru/api/payments/robokassa/success  (метод GET)
#                  Fail URL    https://kamui-collection.ru/api/payments/robokassa/fail     (метод GET)
# Когда все три значения заданы, в форме заказа появляются страны ЕАЭС (если CDEK_COUNTRIES не задан).
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# Алгоритм расчёта хеша — как в технических настройках магазина (по умолчанию MD5)
ROBOKASSA_HASH=md5
# true — тестовые платежи: пароли №1 и №2 тогда берутся из блока «Параметры проведения тестовых платежей»
ROBOKASSA_TEST=false
# true — передавать в Robokassa состав чека (мел и доставка отдельными строками). По умолчанию чек формирует Robokassa
ROBOKASSA_RECEIPT=false
# Выключить Robokassa, не удаляя ключи
# ROBOKASSA_ENABLED=false

# ── Цены для покупателей из-за рубежа (английская версия и доставка СДЭК за пределы России через Robokassa) ──
# Цена 1 шт. в долларах (по умолчанию 48 — в ней уже учтена комиссия Robokassa за карты зарубежных банков)
# PRICE_USD=48
# Цена подарочного набора для заказов из-за рубежа, $ (по умолчанию 83)
# KIT_PRICE_USD=83
# Оптовая цена мела из-за рубежа при заказе от 10 шт., $ (в рублях — 3 000 ₽, задаётся в src/config/products.ts):
# WHOLESALE_PRICE_USD=41
# Надбавка к доставке для заказов из-за рубежа, % (покрывает комиссию Robokassa 9,9%; по умолчанию 11)
# ABROAD_MARKUP_PERCENT=11
# Курс ₽/$ на случай, если сайт ЦБ недоступен
# USD_RATE_FALLBACK=90

# ── Robokassa: проверочная страница /pay-abroad (оплата картой иностранного банка) ──
# EncodedInvoiceId из кода кнопки счёта в личном кабинете Robokassa. Пусто — счёт, заданный в коде.
ROBOKASSA_TEST_INVOICE=

# ── Письма покупателям (после оплаты, трек-номер, напоминание о сроке хранения) ──
# Ящик магазина в Timeweb: с него уходят письма. Пароль — только в панели хостинга.
# База заказов PostgreSQL (Timeweb → база → «Показать данные подключения»); Google Таблица — копия
# DATABASE_URL=postgresql://gen_user:ПАРОЛЬ@АДРЕС:5432/default_db
# DATABASE_CA=  # сертификат Timeweb (PEM) — для проверки сервера базы

# SMTP_USER=shop@abramov.shop
# SMTP_PASSWORD=
# SMTP_HOST=smtp.timeweb.ru
# SMTP_PORT=465
# MAIL_TRANSPORT=auto   # sheets — слать через Gmail владельца таблицы (если хостинг закрыл почтовые порты)
# MAIL_FROM_NAME=Abramov Shop
# CDEK_STORAGE_DAYS=7
# STORAGE_REMIND_DAYS=2
